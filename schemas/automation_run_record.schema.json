{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "repository_revision",
    "validator_version",
    "checks",
    "overall_result"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repository_revision": {
      "type": "string",
      "minLength": 1
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail"]},
          "detail": {"type": "string"}
        }
      }
    },
    "overall_result": {
      "enum": ["pass", "fail", "blocked"]
    },
    "blocker": {
      "type": ["string", "null"]
    }
  }
}
